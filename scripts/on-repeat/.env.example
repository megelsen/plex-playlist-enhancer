# Required
TAUTULLI_URL=http://your-server:8181
TAUTULLI_APIKEY=your-tautulli-api-key
PLEX_URL=http://your-server:32400
PLEX_TOKEN=your-plex-token
MUSIC_SECTION_ID=1

# Optional (defaults shown)
#DAYS=30
#HALF_LIFE_DAYS=7
#MIN_LISTEN_SECONDS=30
#PLAYLIST_TITLE=On Repeat
#PLAYLIST_SIZE=25
#ALLTIME_TOP=3
#ALLTIME_DAYS=3650
#SAVE_BOOST_MULTIPLIER=1.3
#RUN_INTERVAL_DAYS=7
#USER_ID=
#STATE_FILE=           (default: state.json next to script.py; only stores the playlist ratingKey)
