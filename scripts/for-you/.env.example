# Required
TAUTULLI_URL=http://your-server:8181
TAUTULLI_APIKEY=your-tautulli-api-key
PLEX_URL=http://your-server:32400
PLEX_TOKEN=your-plex-token
MUSIC_SECTION_ID=1

# Optional (defaults shown)
#PLAYLIST_TITLE=For You
#ON_REPEAT_TITLE=On Repeat
#DISCOVER_TITLE=Discover Weekly

# Bucket sizes (tracks)
#UNHEARD=20
#RARELY_PLAYED=18
#CLASSICS=12

# Bucket thresholds (percentiles of play counts over the songs you've played; days since last play)
#RARE_PERCENTILE=40
#RARE_MIN_DAYS=30
#CLASSIC_PERCENTILE=85
#CLASSIC_MIN_PLAYS=5
#CLASSIC_MIN_DAYS=21
#FORGOTTEN_SCALE_DAYS=60
#MAX_SKIP_RATIO=0.5
#MIN_TRACK_SECONDS=90

# Taste profile (same meaning as Discover Weekly)
#SEED_DAYS=30
#SEED_HALF_LIFE_DAYS=14
#SEED_RECENT=20
#SEED_ALLTIME=5
#TASTE_HALF_LIFE_DAYS=90
#SEED_ARTISTS=10
#SONIC_LIMIT=40
#MIN_LISTEN_SECONDS=30

# Variety and order
#MAX_PER_ARTIST=2
#MAX_PER_ALBUM=2
#MAX_CLUSTER_SHARE=0.35
#MAX_UNHEARD_RUN=2
#POOL_FACTOR=4
#TEMPERATURE=0.15
#DJ_STRETCH=20
#DJ_NEIGHBOR_LIMIT=3000
#DJ_MAX_DISTANCE=0.6

# Daily rotation (local container time, set TZ)
#RUN_HOUR=5
#RUN_MINUTE=30
#ROTATION_PERCENT=25
#COOLDOWN_DAYS=14
#REBUILD_WEEKDAY=          (e.g. mon for a fresh list every Monday; empty = only rotate)
#HISTORY_WEEKS=6

# Files
#STATE_FILE=               (default: state.json next to script.py)
#DISCOVER_STATE_FILE=      (default: ../discover-weekly/state.json)
#CLUSTER_REGISTRY_PATH=    (optional: the app's cluster_registry.json, mounted read-only)

# One-off modes
#DRY_RUN=false             (print the list, write nothing)
#FULL_REBUILD=false        (build a fresh list instead of rotating)
#BACKTEST_DAYS=0           (e.g. 14: offline check of the scoring, writes nothing)
#USER_ID=
